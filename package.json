{
  "name": "options-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Options trading dashboard with iOS and web apps",
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:backend",
    "dev:web": "cd web && npm run dev:frontend",
    "dev:backend": "convex dev",
    "predev": "convex dev --once",
    "deploy:prod": "convex deploy --prod",
    "deploy:preview": "convex deploy --preview-name preview",
    "build:web": "cd web && npm run build"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.90",
    "convex": "^1.28.2"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
